<?xml version="1.0" encoding="UTF-8"?>
<CVehicleMetadataMgr>

  <VehicleLayoutInfos>
    <Item type="CVehicleLayoutInfo">
      <Name>LAYOUT_VTOL_CV22</Name>

      <Seats>
        <!-- Cockpit -->
        <Item>
          <SeatInfo ref="SEAT_HELI_VALKYRIE_FRONT_LEFT"/>
          <SeatAnimInfo ref="SEAT_ANIM_HELI_FRONT_LEFT"/>
        </Item>
        <Item>
          <SeatInfo ref="SEAT_HELI_VALKYRIE_FRONT_RIGHT"/>
          <SeatAnimInfo ref="SEAT_ANIM_HELI_FRONT_RIGHT"/>
        </Item>

        <!-- Rear -->
        <Item>
          <SeatInfo ref="SEAT_CH47_REAR_LEFT"/>
          <SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/>
        </Item>
        <Item>
          <SeatInfo ref="SEAT_CH47_REAR_RIGHT"/>
          <SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/>
        </Item>

        <!-- Left -->
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_1"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_2"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_3"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_4"/><SeatAnimInfo ref="SEAT_ANIM_HELI_RAMP"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_5"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_LEFT_6"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_LEFT"/></Item>

        <!-- Right -->
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_1"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_2"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_3"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_4"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_5"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
        <Item><SeatInfo ref="SEAT_EXTRA_CV22_RIGHT_6"/><SeatAnimInfo ref="SEAT_ANIM_PLANE_TITAN_RIGHT"/></Item>
      </Seats>

      <EntryPoints>
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_CV22_WARP"/>
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_CARGOBOB_REAR_RIGHT"/>
        </Item>
      </EntryPoints>

      <LayoutFlags>StreamAnims WarpIntoAndOut UseFinerAlignTolerance Use2DBodyBlend</LayoutFlags>
      <BicycleInfo ref="NULL"/>
      <HandsUpClipSetId>busted_vehicle_std</HandsUpClipSetId>
      <SteeringWheelOffset x="0.000000" y="0.350000" z="0.320000"/>
    </Item>
  </VehicleLayoutInfos>



  <VehicleEntryPointInfos>
    <Item type="CVehicleEntryPointInfo">
      <Name>ENTRY_POINT_CV22_WARP</Name>
      <DoorBoneName/>
      <SecondDoorBoneName/>
      <DoorHandleBoneName/>
      <WindowId>INVALID</WindowId>
      <VehicleSide>SIDE_LEFT</VehicleSide>

      <AccessableSeats>
        <Item ref="SEAT_HELI_VALKYRIE_FRONT_LEFT"/>
        <Item ref="SEAT_HELI_VALKYRIE_FRONT_RIGHT"/>
        <Item ref="SEAT_CH47_REAR_LEFT"/>
        <Item ref="SEAT_CH47_REAR_RIGHT"/>

        <Item ref="SEAT_EXTRA_CV22_LEFT_1"/>
        <Item ref="SEAT_EXTRA_CV22_LEFT_2"/>
        <Item ref="SEAT_EXTRA_CV22_LEFT_3"/>
        <Item ref="SEAT_EXTRA_CV22_LEFT_4"/>
        <Item ref="SEAT_EXTRA_CV22_LEFT_5"/>
        <Item ref="SEAT_EXTRA_CV22_LEFT_6"/>

        <Item ref="SEAT_EXTRA_CV22_RIGHT_1"/>
        <Item ref="SEAT_EXTRA_CV22_RIGHT_2"/>
        <Item ref="SEAT_EXTRA_CV22_RIGHT_3"/>
        <Item ref="SEAT_EXTRA_CV22_RIGHT_4"/>
        <Item ref="SEAT_EXTRA_CV22_RIGHT_5"/>
        <Item ref="SEAT_EXTRA_CV22_RIGHT_6"/>
      </AccessableSeats>

      <VehicleExtraPointsInfo ref="NULL"/>
      <Flags>IgnoreSmashWindowCheck MPWarpInOut SPEntryAllowedAlso</Flags>
      <BlockJackReactionSides/>
    </Item>
  </VehicleEntryPointInfos>



  <VehicleExtraPointsInfos/>
  <VehicleEntryPointAnimInfos>



  </VehicleEntryPointAnimInfos>



  <VehicleSeatAnimInfos>
    <Item type="CVehicleSeatAnimInfo">
      <Name>SEAT_ANIM_HELI_RAMP</Name>
      <DriveByInfo ref="DRIVEBY_TRUCK_PHANTOMBULL_REAR"/>
